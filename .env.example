# ====================================================================
# MEETWO V3.1 ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development.
# ====================================================================

# --------------------------------------------------------------------
# 1. Supabase Configuration (Application Data, Auth, Profiles, Chat)
# --------------------------------------------------------------------
# If left unset or with placeholder values, Meetwo runs in zero-config
# multi-tab offline/demo mode with seeded data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --------------------------------------------------------------------
# 2. LiveKit SFU Media Configuration (Primary Production Transport)
# --------------------------------------------------------------------
# LiveKit Cloud or self-hosted LiveKit server WebSocket URL (wss://...)
VITE_LIVEKIT_URL=wss://your-livekit-project.livekit.cloud

# Production Token Endpoint (Recommended):
# Resolves dynamic JWT tokens per-room and per-user identity without
# exposing your LiveKit API Secret to client browsers.
# If using Supabase Edge Functions, this defaults to:
# ${VITE_SUPABASE_URL}/functions/v1/livekit-token
VITE_LIVEKIT_TOKEN_ENDPOINT=

# Local / Dev Testing Token (Optional):
# Only use for local sandboxing or single-user testing.
# NEVER commit or hardcode production credentials here.
VITE_LIVEKIT_TOKEN=

# --------------------------------------------------------------------
# 3. Application Environment Mode
# --------------------------------------------------------------------
# Options: development | staging | production
VITE_APP_ENV=development
